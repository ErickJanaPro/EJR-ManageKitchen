# Copier en .env (jamais commité). Les valeurs par défaut suffisent en local.
DB_NAME=ejr_kitchen
DB_USER=ejr
DB_PASSWORD=ejr
DB_URL=jdbc:postgresql://localhost:5432/ejr_kitchen
# Au moins 32 caractères
JWT_SECRET=change-moi-avec-une-cle-secrete-de-32-caracteres-minimum
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# E-mails (mode log par défaut ; smtp + Mailpit en local : http://localhost:8025)
EMAIL_MODE=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ejr-managekitchen.local